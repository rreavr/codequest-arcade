# Salin menjadi .env lalu isi dari dashboard Supabase (Project Settings > API).
# Jangan pernah commit .env.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Hanya dipakai di server (endpoint /api dan ekspor). Jangan diawali PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — rencana migrasi berkas fisik vault yang DITUNDA; belum dipakai
# (vault kini berupa tautan di tabel berkas_vault, dikelola dari /kelola/vault).
# Bila nanti dilanjutkan: buat bucket (mis. codequest-vault) lalu API token
# "Object Read & Write" yang di-scope hanya ke bucket itu (R2 > Manage API Tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=codequest-vault
